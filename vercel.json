{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "headers": [
    {
      "source": "/:dir(assets|\\.well-known|alphonso|avatar|avatars|badges|brand|clips|figures|firstrun|flags|fonts|hector|icons3d|mascots|paywall|scenes|sfx|voices)/:path*",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/:file(apple-touch-icon\\.png|favicon-16\\.png|favicon-32\\.png|favicon\\.ico|icon-192\\.png|icon-512\\.png|og-image\\.png|site\\.webmanifest)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
