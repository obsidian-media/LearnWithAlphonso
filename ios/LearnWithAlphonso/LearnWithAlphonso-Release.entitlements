<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- V4 candidate #2 (real push) -- a TestFlight/App Store archive's
	     device tokens register against APNs' production environment.
	     Wired into project.yml's Release config (CODE_SIGN_ENTITLEMENTS)
	     2026-09-22, after confirming (via a read-only App Store Connect
	     API check, not assumed) the Push Notifications capability is
	     enabled on the App ID, and regenerating the Distribution
	     provisioning profile to include it -- reusing the existing
	     certificate, no new one minted, so this didn't repeat the
	     certificate-cap incident (docs/BACKLOG.md sec 1.1). See
	     docs/BACKLOG.md sec 1.3 for the full trail. Push delivery itself
	     is still unverified end-to-end -- that needs a real TestFlight
	     build and a physical device, not just a config check. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Sign in with Apple (App Store Guideline 4.8). Requires "Sign in
	     with Apple" enabled on the App ID. Confirmed via a read-only App
	     Store Connect API check (2026-09-28, submission-readiness audit):
	     bundleIdCapabilities for com.obsidianmedia.learnwithalphonso
	     includes APPLE_ID_AUTH. The signed archive workflow (manual
	     signing, this exact entitlements file) has been green through
	     build 28, which is itself evidence the Distribution provisioning
	     profile in use does support this entitlement, since a profile
	     that didn't support it would fail codesigning outright rather
	     than silently ignore it. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- App Group shared with LearnWithAlphonsoWidget (WidgetSharing.swift,
	     WidgetProgressPublisher.swift). project.yml's generated entitlements
	     declare this too, but this hand-written file is what Release
	     actually signs against (CODE_SIGN_ENTITLEMENTS), and it never had
	     this key: a real gap found in a 2026-09-28 audit. The widget's own
	     entitlements (auto-generated, no override) already had App Group
	     access, so it could read the shared container, but the main app
	     was never actually authorized to write into it in a signed build.
	     The App ID's App Groups capability is confirmed enabled via a live
	     API check the same day; if the Distribution provisioning profile
	     predates that, codesigning will fail outright here rather than
	     silently ignore it, which is the signal to regenerate it
	     (manage-ios-certificates.ts / regenerate-ios-profile.yml). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.obsidianmedia.learnwithalphonso</string>
	</array>
</dict>
</plist>
