<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the GENERATE_INFOPLIST_FILE-synthesized Info.plist
	     (Xcode 13+ supports both at once) -- this is the one entry that
	     can't be expressed as a flat INFOPLIST_KEY_* build setting.
	     Lets ASWebAuthenticationSession hand control back to this app once
	     Google sign-in completes -- see GoogleSignInPresenter.swift and
	     AppConfig.googleSignInURLScheme. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.obsidianmedia.learnwithalphonso</string>
			</array>
		</dict>
	</array>
	<!-- Export compliance, answered directly so App Store Connect doesn't
	     ask on every submission. All network calls (Supabase, RevenueCat,
	     NVIDIA, Deepgram, APNs registration) go over plain HTTPS/TLS via
	     URLSession -- Apple's own OS-provided encryption, always exempt.
	     The one piece of hand-implemented crypto in this app,
	     LearnWithAlphonsoKit/SHA256Pure.swift (a standard FIPS 180-4
	     SHA-256, not proprietary), is used only to derive a PKCE
	     code_challenge for Google sign-in -- authentication/integrity,
	     never confidentiality of user data -- which is the specific
	     exemption in EAR Category 5 Part 2 / Sec. 740.17(b)(1). If this
	     app ever adds encryption for actual data confidentiality (e.g.
	     encrypting stored content, not just an OAuth handshake), this
	     needs re-evaluating -- don't copy this value forward blindly. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- RevenueCat's public SDK key, moved here from a per-config
	     INFOPLIST_KEY_RCApiKey build setting in project.yml on 2026-09-23
	     after proving that setting never actually reaches the built app:
	     confirmed present and correctly resolved in both the generated
	     .pbxproj and xcodebuild's own effective build settings, yet
	     absent from the final archived Info.plist (checked two
	     independent ways: `plutil -p` and `PlistBuddy -c Print`, both
	     with real exit-code checks). Root cause: Xcode's
	     GENERATE_INFOPLIST_FILE-synthesis-merged-with-a-real-INFOPLIST_FILE
	     mode (this target uses both, same as CFBundleURLTypes above)
	     appears to only merge Apple's own well-known Info.plist keys via
	     INFOPLIST_KEY_*, not arbitrary custom ones, exactly the same
	     class of limitation CFBundleURLTypes above already worked around.
	     Default value here is the RevenueCat Test Store key (safe for
	     local/Simulator/Debug builds, see AppConfig.swift). Never leave
	     this as the test_ key in a real signed archive: RevenueCat's SDK
	     deliberately asserts on a Test Store key reaching a TestFlight or
	     App Store distributed build (crashed every tester's launch on
	     2026-09-19). ios-release.yml's Release archive job substitutes
	     the real production key (REVENUECAT_API_KEY secret) over this
	     exact string with `sed` before archiving, see that workflow's
	     "Generate Xcode project" step. -->
	<key>RCApiKey</key>
	<string>test_UzoFLqAlXAHPWSwBgKQuZcqFKrq</string>
	<!-- Design system (all 3 themes, see DesignSystem/AlphonsoTheme.swift
	     and AlphonsoFont.swift): each theme's display/sans font pair,
	     bundled as upstream variable-font files under Sources/Fonts/
	     (XcodeGen picks up non-Swift files under a `sources:` path as
	     Copy Bundle Resources automatically, same as Assets.xcassets).
	     Instrument Serif is the one static (non-variable) file -- the web
	     app only ever loads its italic axis for Studio Ink, never bold.
	     Registering by filename here is the standard "Fonts provided by
	     application" mechanism -- no project.yml change needed. -->
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces-Variable.ttf</string>
		<string>Geist-Variable.ttf</string>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSans-Variable.ttf</string>
		<string>Newsreader-Variable.ttf</string>
		<string>SourceSans3-Variable.ttf</string>
	</array>
</dict>
</plist>
