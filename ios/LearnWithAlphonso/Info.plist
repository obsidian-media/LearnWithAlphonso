<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the GENERATE_INFOPLIST_FILE-synthesized Info.plist
	     (Xcode 13+ supports both at once) -- this is the one entry that
	     can't be expressed as a flat INFOPLIST_KEY_* build setting.
	     Lets ASWebAuthenticationSession hand control back to this app once
	     Google sign-in completes -- see GoogleSignInPresenter.swift and
	     AppConfig.googleSignInURLScheme. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.obsidianmedia.learnwithalphonso</string>
			</array>
		</dict>
	</array>
	<!-- Export compliance, answered directly so App Store Connect doesn't
	     ask on every submission. All network calls (Supabase, RevenueCat,
	     NVIDIA, Deepgram, APNs registration) go over plain HTTPS/TLS via
	     URLSession -- Apple's own OS-provided encryption, always exempt.
	     The one piece of hand-implemented crypto in this app,
	     LearnWithAlphonsoKit/SHA256Pure.swift (a standard FIPS 180-4
	     SHA-256, not proprietary), is used only to derive a PKCE
	     code_challenge for Google sign-in -- authentication/integrity,
	     never confidentiality of user data -- which is the specific
	     exemption in EAR Category 5 Part 2 / Sec. 740.17(b)(1). If this
	     app ever adds encryption for actual data confidentiality (e.g.
	     encrypting stored content, not just an OAuth handshake), this
	     needs re-evaluating -- don't copy this value forward blindly. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
