<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- V4 candidate #2 (real push) -- Debug/Simulator builds' device
	     tokens register against APNs' sandbox environment. See
	     docs/superpowers/specs/2026-09-21-remote-push-notifications-design.md.
	     Push Notifications capability is confirmed enabled on the App ID
	     (see the Release entitlements file's own comment) -- an unsigned/
	     Simulator build (ios-app-build CI, CODE_SIGNING_ALLOWED=NO) never
	     enforces entitlements at all regardless. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple (App Store Guideline 4.8) -- see the Release
	     entitlements file's own comment for the live confirmation. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
