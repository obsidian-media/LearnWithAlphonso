# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/

# superpowers:executing-plans / subagent-driven-development scratch workspace
.superpowers/

# Vercel CLI local project link (machine-specific)
.vercel
.dev.vars

# Supabase CLI local dev state (branches, temp connection info)
supabase/.branches/
supabase/.temp/

# Serena MCP server's local project state
.serena/

# Environment variables — never commit real secrets/keys
.env
.env.local
.env.*.local

# Agent working notes — deferred/postponed work items, local-only scratch
DEFERRED-WORDS.md

# Audit reports — local-only working documents (2026-09-18): these go
# stale within weeks and repeatedly needed re-verification against code
# on every prior pass, so they're kept out of shared history rather than
# calcifying into false "documentation" future readers trust instead of
# re-checking the actual code.
AUDIT.md
ClaudeCodeComprehensiveMulti-AngleAudit—2026-09-18.md

# V2 kickoff docs — local-only briefing documents (2026-09-19) for
# handing off individual V2 feature work to fresh Claude Code sessions/
# subagents without burning their context on this session's full
# history. Not committed: they're working handoff notes, not
# documentation of the shipped app (see docs/superpowers/specs/ for
# that) -- verify against current code before trusting one if it's been
# a while.
/docs/v2-kickoffs/

# V3 kickoff docs — same pattern as the V2 ones above (2026-09-20):
# local-only briefing docs for handing off individual V3 feature
# candidates to fresh sessions. Not committed for the same reason.
/docs/v3-kickoffs/

# Master backlog doc (2026-09-21) — consolidates DEFERRED-WORDS.md,
# the v2/v3 kickoff docs above, and ARCHITECTURE.md/AGENTS.md's still-
# open items into one place so nothing raised in conversation gets
# forgotten. Local-only for the same reason as everything else here:
# it drifts fast and would calcify into stale "documentation" if
# committed. See the file itself for how to keep it current.
docs/BACKLOG.md

# V4 kickoff docs — same pattern as the V2/V3 kickoff docs above
# (2026-09-21): local-only briefing docs for handing off individual V4
# feature candidates to fresh sessions. Not committed for the same
# reason.
/docs/v4-kickoffs/

# Hector weakness-detection design spec (2026-09-20) -- internal
# decision doc for an unreleased feature, kept local rather than in
# shared history until it ships.
/docs/superpowers/specs/2026-09-20-hector-weakness-detection-design.md

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Vitest coverage reports
/coverage/

# Swift Package Manager build artifacts (ios/LearnWithAlphonsoKit)
.build/

# ios/LearnWithAlphonso's .xcodeproj is XcodeGen-generated from project.yml
# (`xcodegen generate`) -- never hand-edited or committed, so it can't
# drift from the source of truth or cause merge conflicts.
ios/LearnWithAlphonso/*.xcodeproj/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Same "XcodeGen-generated, never committed" treatment for the
# .entitlements files project.yml's `entitlements.properties` blocks
# generate (App Group, for the LearnWithAlphonsoWidget slice).
ios/LearnWithAlphonso/*.entitlements
ios/LearnWithAlphonso/LearnWithAlphonsoWidget/*.entitlements

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
