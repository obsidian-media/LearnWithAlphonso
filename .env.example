SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
# Cloudflare Turnstile site key (public). Set it to show the captcha on the web email forms; then the
# auth server captcha setting can be switched on for the web (src/lib/turnstile.ts).
VITE_TURNSTILE_SITE_KEY=""

# Server-only — used by src/integrations/supabase/client.server.ts for
# privileged operations. Never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only AI provider keys — used directly by src/routes/api/chat.ts,
# tts.ts, stt.ts. Replaces the old single LOVABLE_API_KEY.
# Chat: OpenRouter (openrouter.ai, OpenAI-compatible). Key from
# openrouter.ai/keys; the workspace's own provider keys (BYOK) are set to
# "Never use shared capacity". LLM_CHAT_MODELS is an ordered, comma-separated
# list of OpenRouter model ids: the first is tried first and OpenRouter falls
# back to the next on any error. Empty means the default in
# src/lib/llm-chat-model.server.ts (mirrored in
# supabase/functions/_shared/llm-chat.ts). Every provider you list must be
# named in the privacy policy. After changing it, run
# scripts/benchmark-llm.ts and scripts/smoke-llm-features.ts: reasoning must
# stay off (src/lib/llm-chat.server.ts) or replies get slow and cut off.
OPENROUTER_API_KEY=""
LLM_CHAT_MODELS=""
# LLM_PROVIDERS: the only hosts OpenRouter may send learner text to (its
# provider.only), comma-separated provider slugs. Empty means "anthropic".
# Every host listed needs its own processor entry in the privacy policy.
LLM_PROVIDERS=""
# RevenueCat. Web Billing (Stripe) sells Alphonso Pro on the website; never put Stripe keys here.
REVENUECAT_SECRET_API_KEY=""
REVENUECAT_V2_SECRET_KEY=""
REVENUECAT_PROJECT_ID=""
REVENUECAT_WEB_PRODUCT_ID=""
REVENUECAT_WEB_PURCHASE_LINK=""
REVENUECAT_WEB_PURCHASE_LINK_NO_TRIAL=""
# Test Store purchases never grant Pro, except for these comma-separated user ids
# (the owner's own test accounts). REVENUECAT_REJECT_SANDBOX="true" also stops
# Apple/Google sandbox purchases counting for anyone else; leave it unset while
# App Review or TestFlight testers need to buy in the sandbox.
REVENUECAT_TEST_PURCHASE_USER_IDS=""
REVENUECAT_REJECT_SANDBOX=""
# Separate subscription identifier (src/lib/revenuecat-entitlement.ts): at least 32 random characters, the same value
# in Supabase Edge Function secrets. Never change it once set. Unset = RevenueCat gets the account id, as before.
SUBSCRIPTION_ID_SECRET=""

# Admin tool: "true" requires a second factor (an authenticator code) on every admin session.
# Enrol an authenticator on the admin sign-in page first, then set this on the admin deployment.
ADMIN_REQUIRE_AAL2=""
# TTS/STT: Deepgram directly (plain REST, works from a Vercel serverless
# function with no audio transcoding needed — NVIDIA's hosted speech APIs
# are gRPC-only with no mature Node client, not worth the platform risk;
# OpenAI was the original choice but a key was never provided). Get a key
# at deepgram.com (new accounts get $200 free credit).
DEEPGRAM_API_KEY=""
# Optional: daily voice (speech-to-text) seconds per learner, default 1200 (20 min),
# and the longest single recording in seconds, default 120.
# STT_DAILY_AUDIO_SECONDS=1200
# STT_MAX_CALL_SECONDS=120

# Server-only — signs the short-lived HMAC token that proves a lesson
# session was actually started before completeLessonRemote accepts a
# completion (src/lib/lesson-session.server.ts). Any long random string;
# generate one with `openssl rand -base64 48`. Rotating it invalidates all
# in-flight lesson sessions (harmless — the client just re-fetches one).
LESSON_SESSION_SECRET=""

# "Please update" gate for the iOS and Android apps (src/lib/app-update-gate.ts). Unset = off.
APP_MIN_IOS_BUILD=""
APP_MIN_ANDROID_VERSION_CODE=""
APP_IOS_STORE_URL=""
APP_ANDROID_STORE_URL=""
