# Server-only — used by src/integrations/supabase/client.server.ts for
# privileged operations. Never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only AI provider keys — used directly by src/routes/api/chat.ts,
# tts.ts, stt.ts. Replaces the old single LOVABLE_API_KEY.
# Chat: NVIDIA NIM (integrate.api.nvidia.com, OpenAI-compatible). Get a key
# at build.nvidia.com. Optionally override the model via NVIDIA_CHAT_MODEL
# (default: meta/llama-3.1-70b-instruct — verify still live in NVIDIA's
# catalog, it changes).
NVIDIA_API_KEY=""
NVIDIA_CHAT_MODEL=""
# TTS/STT: Deepgram directly (plain REST, works from a Vercel serverless
# function with no audio transcoding needed — NVIDIA's hosted speech APIs
# are gRPC-only with no mature Node client, not worth the platform risk;
# OpenAI was the original choice but a key was never provided). Get a key
# at deepgram.com (new accounts get $200 free credit).
DEEPGRAM_API_KEY=""
